<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>

    <Product>Chess Atlas</Product>
    <Company>InnbyErfan</Company>
    <VersionPrefix>0.1.0</VersionPrefix>
    <NeutralLanguage>en</NeutralLanguage>

    <!--
      Warnings become errors in CI only (ci.yml passes /p:TreatWarningsAsErrors=true). Keeping them
      non-fatal locally means a new SDK with a new analyser cannot block someone mid-edit, while CI
      still refuses to merge noise.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
