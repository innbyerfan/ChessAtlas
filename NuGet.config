<?xml version="1.0" encoding="utf-8"?>
<!--
  One feed, declared explicitly.

  Without this file the resolved sources depend on whatever the machine's NuGet defaults are, so
  "it builds on my box" and "it builds in CI" can quietly mean different things. Pinning nuget.org
  here means every build — local, CI, or a contributor's — resolves packages from the same place,
  and Directory.Packages.props is the single place a version is chosen.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageRestore>
    <!-- Deterministic restores: never silently fall back to a cached package of a different version. -->
    <add key="noCache" value="false" />
  </packageRestore>
</configuration>
